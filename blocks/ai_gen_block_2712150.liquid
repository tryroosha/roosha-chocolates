{% doc %}
  Premium Contact Us for Ashtitva. Warm, honest, modern premium contact experience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-us-{{ ai_gen_id }} {
    --cu-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cu-gold: var(--ashtitva-gold, #b89a5a);
    --cu-forest: var(--ashtitva-green, #123c32);
    --cu-ivory: var(--ashtitva-ivory, #f7f3e9);
    --cu-soft: var(--ashtitva-ivory-soft, #fcfaf4);
    display: block;
    width: 100%;
    color: {{ block.settings.card_text_color }};
    background: var(--cu-ivory);
  }

  .ai-contact-hero-{{ ai_gen_id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, color-mix(in srgb, {{ block.settings.hero_bg_color }} 88%, #fff) 0%, transparent 70%),
      linear-gradient(180deg, {{ block.settings.hero_bg_color }} 0%, #ffffff 100%);
    padding: {{ block.settings.hero_padding_mobile }}px 24px {{ block.settings.hero_padding_mobile | times: 0.75 | round }}px;
    text-align: center;
    width: 100%;
  }

  .ai-contact-hero-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    inset: auto 10% -40% 10%;
    height: 55%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, color-mix(in srgb, #c5a059 8%, transparent), transparent 70%);
  }

  .ai-contact-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .ai-contact-hero-eyebrow-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 0.8rem;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cu-gold);
    line-height: 1.3;
  }

  .ai-contact-hero-eyebrow-{{ ai_gen_id }}::before,
  .ai-contact-hero-eyebrow-{{ ai_gen_id }}::after {
    display: none;
  }

  .ai-contact-hero-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style, normal);
    font-size: {{ block.settings.hero_title_size_mobile }}px;
    color: {{ block.settings.hero_text_color }};
    margin: 0 0 18px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ai-contact-hero-subtext-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-style: var(--font-body-style, normal);
    font-weight: 400;
    font-size: {{ block.settings.hero_subtext_size_mobile }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.75;
    letter-spacing: 0.01em;
    max-width: 560px;
    margin: 0 auto;
  }

  .ai-contact-hero-subtext-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-contact-hero-rule-{{ ai_gen_id }} {
    display: none;
  }

  .ai-contact-details-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.details_padding_mobile }}px 24px;
    background: {{ block.settings.details_bg_color }};
    width: 100%;
  }

  .ai-contact-details-container-{{ ai_gen_id }} {
    max-width: 1120px;
    margin: 0 auto;
  }

  .ai-contact-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .ai-contact-card-{{ ai_gen_id }},
  a.ai-contact-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100%;
    background-color: {{ block.settings.card_bg_color }};
    border: none;
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px 24px 28px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 10px 30px rgba(42, 42, 42, 0.05);
    cursor: default;
    transition:
      transform 0.45s var(--cu-ease),
      box-shadow 0.45s var(--cu-ease),
      background-color 0.45s var(--cu-ease);
  }

  a.ai-contact-card-{{ ai_gen_id }} {
    cursor: pointer;
  }

  a.ai-contact-card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #c5a059;
    outline-offset: 3px;
  }

  .ai-contact-card-{{ ai_gen_id }}::after,
  a.ai-contact-card-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, #c5a059 40%, transparent),
      transparent
    );
    opacity: 0;
    transition: opacity 0.45s var(--cu-ease), left 0.45s var(--cu-ease), right 0.45s var(--cu-ease);
  }

  @media (hover: hover) {
    .ai-contact-card-{{ ai_gen_id }}:hover,
    a.ai-contact-card-{{ ai_gen_id }}:hover {
      transform: translateY(-3px);
      background: color-mix(in srgb, {{ block.settings.card_bg_color }} 94%, #fdf9f2);
      box-shadow: 0 18px 40px rgba(42, 42, 42, 0.08);
    }

    .ai-contact-card-{{ ai_gen_id }}:hover::after,
    a.ai-contact-card-{{ ai_gen_id }}:hover::after {
      opacity: 1;
      left: 24%;
      right: 24%;
    }

    .ai-contact-card-{{ ai_gen_id }}:hover .ai-contact-card-icon-{{ ai_gen_id }},
    a.ai-contact-card-{{ ai_gen_id }}:hover .ai-contact-card-icon-{{ ai_gen_id }} {
      background: color-mix(in srgb, {{ block.settings.icon_bg_color }} 55%, #fff);
      color: #c5a059;
    }

    a.ai-contact-card-{{ ai_gen_id }}:hover .ai-contact-card-text-{{ ai_gen_id }} {
      color: {{ block.settings.card_link_color }};
    }
  }

  .ai-contact-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    color: {{ block.settings.icon_color }};
    box-shadow: none;
    transition:
      background-color 0.45s var(--cu-ease),
      color 0.45s var(--cu-ease);
  }

  .ai-contact-card-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.42);
    height: calc({{ block.settings.icon_size }}px * 0.42);
  }

  .ai-contact-card-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style, normal);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 4px;
  }

  .ai-contact-card-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 400;
    color: {{ block.settings.card_text_color }};
    line-height: 1.45;
    margin: 6px 0 0;
    white-space: normal;
    transition: color 0.3s ease;
  }

  .ai-contact-card-text-{{ ai_gen_id }}--multiline {
    white-space: pre-line;
  }

  a.ai-contact-card-{{ ai_gen_id }} .ai-contact-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.card_link_color }};
  }


  /* —— Form —— */
  .ai-contact-form-wrap-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.form_padding_mobile }}px 24px;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, color-mix(in srgb, #fdf9f2 90%, #fff), transparent 70%),
      linear-gradient(180deg, #ffffff 0%, #fdf9f2 55%, #ffffff 100%);
    width: 100%;
  }

  .ai-contact-form-inner-{{ ai_gen_id }} {
    max-width: 760px;
    margin: 0 auto;
  }

  .ai-contact-form-intro-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 28px;
  }

  .ai-contact-form-eyebrow-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 0.8rem;
    font-family: var(--ash-font-body, var(--font-body-family));
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cu-gold);
    line-height: 1.3;
  }

  .ai-contact-form-eyebrow-{{ ai_gen_id }}::before,
  .ai-contact-form-eyebrow-{{ ai_gen_id }}::after {
    display: none;
  }

  .ai-contact-form-title-{{ ai_gen_id }} {
    font-family: var(--ash-font-display, var(--font-heading-family));
    font-style: var(--font-heading-style, normal);
    font-size: 2.8rem;
    font-weight: 400;
    color: {{ block.settings.form_title_color }};
    margin: 0 0 12px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ai-contact-form-subtitle-{{ ai_gen_id }} {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.7;
    color: {{ block.settings.card_text_color }};
  }

  .ai-contact-form-panel-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.form_background }};
    border: none;
    border-radius: {{ block.settings.form_border_radius }}px;
    padding: 36px 28px 40px;
    box-shadow: 0 16px 48px rgba(42, 42, 42, 0.07);
  }

  .ai-contact-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 20px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    margin-bottom: 18px;
  }

  .ai-contact-form-field-{{ ai_gen_id }}--full {
    grid-column: 1 / -1;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    display: block;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
    color: {{ block.settings.form_label_color }};
    margin-bottom: 8px;
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    box-sizing: border-box;
    padding: 15px 18px;
    border: none;
    border-radius: 12px;
    font-family: var(--font-body-family);
    font-size: 16px;
    color: {{ block.settings.form_input_text }};
    background: {{ block.settings.form_input_background }};
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    appearance: none;
  }

  .ai-contact-form-input-{{ ai_gen_id }}::placeholder,
  .ai-contact-form-textarea-{{ ai_gen_id }}::placeholder {
    color: color-mix(in srgb, {{ block.settings.card_text_color }} 65%, transparent);
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    background: #ffffff;
    box-shadow: 0 0 0 2px color-mix(in srgb, {{ block.settings.form_input_focus_border }} 30%, transparent);
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 150px;
    resize: vertical;
    line-height: 1.6;
  }

  .ai-contact-form-actions-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 280px;
    min-height: 52px;
    padding: 16px 28px;
    background: {{ block.settings.form_button_background }};
    color: {{ block.settings.form_button_text_color }};
    border: 1px solid rgba(43, 43, 43, 0.35);
    border-radius: 6px;
    box-shadow: none;
    font-family: var(--font-body-family);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  @media (hover: hover) {
    .ai-contact-form-button-{{ ai_gen_id }}:hover {
      background: {{ block.settings.form_button_hover_background }};
      border-color: #a8843f;
      color: {{ block.settings.form_button_text_color }};
      transform: none;
      box-shadow: none;
    }
  }

  .ai-contact-form-button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #c5a059;
    outline-offset: 3px;
  }

  .ai-contact-form-success-{{ ai_gen_id }},
  .ai-contact-form-error-{{ ai_gen_id }} {
    padding: 14px 16px;
    border-radius: 10px;
    margin-bottom: 20px;
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    background: color-mix(in srgb, #fdf9f2 70%, #dce9df);
    color: #2f4a38;
    border: none;
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    background: #fbf2f2;
    color: #6b3030;
    border: none;
  }

  .ai-contact-trust-line-{{ ai_gen_id }} {
    margin: 24px auto 0;
    max-width: 480px;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.65;
    color: {{ block.settings.trust_text_color }};
  }

  .ai-contact-social-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.social_padding_mobile }}px 24px;
    background: linear-gradient(180deg, #ffffff 0%, {{ block.settings.social_bg_color }} 28%, {{ block.settings.social_bg_color }} 100%);
    text-align: center;
    width: 100%;
  }

  .ai-contact-social-container-{{ ai_gen_id }} {
    max-width: 640px;
    margin: 0 auto;
  }

  .ai-contact-social-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style, normal);
    font-size: {{ block.settings.social_title_size_mobile }}px;
    color: {{ block.settings.social_text_color }};
    margin: 0 0 14px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .ai-contact-social-note-{{ ai_gen_id }} {
    margin: 0 0 32px;
    font-family: var(--font-body-family);
    font-size: 16px;
    line-height: 1.65;
    color: {{ block.settings.card_text_color }};
  }

  .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} {
    --social-hit-size: 56px;
    --social-icon-size: calc(56px * 0.42);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0 auto;
    width: 100%;
  }

  .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} .list-social__link,
  .ai-contact-social-{{ ai_gen_id }} .ai-contact-social-link-{{ ai_gen_id }} {
    width: var(--social-hit-size);
    height: var(--social-hit-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: {{ block.settings.social_icon_bg_color }};
    border: none;
    border-radius: 50%;
    color: {{ block.settings.social_icon_color }};
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(42, 42, 42, 0.06);
    transition:
      transform 0.4s var(--cu-ease),
      background-color 0.4s var(--cu-ease),
      color 0.4s var(--cu-ease),
      box-shadow 0.4s var(--cu-ease);
  }

  @media (hover: hover) {
    .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} .list-social__link:hover,
    .ai-contact-social-{{ ai_gen_id }} .ai-contact-social-link-{{ ai_gen_id }}:hover {
      transform: translateY(-2px);
      background-color: {{ block.settings.social_icon_hover_bg }};
      color: #c5a059;
      box-shadow: 0 12px 26px rgba(42, 42, 42, 0.09);
    }
  }

  .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} .list-social__link:focus-visible,
  .ai-contact-social-{{ ai_gen_id }} .ai-contact-social-link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid #c5a059;
    outline-offset: 3px;
  }

  .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} .list-social__link .svg-wrapper,
  .ai-contact-social-{{ ai_gen_id }} .list-social.ai-contact-social-icons-{{ ai_gen_id }} .list-social__link svg,
  .ai-contact-social-{{ ai_gen_id }} .ai-contact-social-link-{{ ai_gen_id }} svg {
    width: var(--social-icon-size);
    height: var(--social-icon-size);
  }

  .ai-contact-reveal-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.75s var(--cu-ease), transform 0.75s var(--cu-ease);
  }

  .ai-contact-reveal-{{ ai_gen_id }}.is-visible {
    opacity: 1;
    transform: none;
  }

  .ai-contact-card-{{ ai_gen_id }}.ai-contact-reveal-{{ ai_gen_id }} {
    transition-delay: calc(var(--cu-stagger, 0) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-contact-reveal-{{ ai_gen_id }},
    .ai-contact-card-{{ ai_gen_id }},
    .ai-contact-social-link-{{ ai_gen_id }},
    .ai-contact-card-icon-{{ ai_gen_id }} {
      transition: none !important;
      opacity: 1;
      transform: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-contact-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.hero_padding_desktop }}px 48px {{ block.settings.hero_padding_desktop | times: 0.8 | round }}px;
    }

    .ai-contact-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size_desktop }}px;
    }

    .ai-contact-hero-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_subtext_size_desktop }}px;
    }

    .ai-contact-details-{{ ai_gen_id }} {
      padding: {{ block.settings.details_padding_desktop }}px 48px;
    }

    .ai-contact-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .ai-contact-card-{{ ai_gen_id }} {
      padding: 36px 28px 32px;
    }

    .ai-contact-card-title-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-contact-card-text-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-contact-form-wrap-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding_desktop }}px 48px;
    }

    .ai-contact-form-title-{{ ai_gen_id }} {
      font-size: 40px;
    }

    .ai-contact-form-panel-{{ ai_gen_id }} {
      padding: 44px 40px 48px;
    }

    .ai-contact-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }

    .ai-contact-social-{{ ai_gen_id }} {
      padding: {{ block.settings.social_padding_desktop }}px 48px;
    }

    .ai-contact-social-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.social_title_size_desktop }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-contact-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      max-width: 760px;
      margin: 0 auto;
    }
  }
{% endstyle %}

<contact-us-section-{{ ai_gen_id }} class="ai-contact-us-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-hero-{{ ai_gen_id }}">
    <div class="ai-contact-hero-content-{{ ai_gen_id }} ai-contact-reveal-{{ ai_gen_id }}" data-cu-reveal>
      <p class="ai-contact-hero-eyebrow-{{ ai_gen_id }}">We’re here for you</p>
      {% if block.settings.hero_title != blank %}
        <h1 class="ai-contact-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
      {% endif %}
      {% if block.settings.hero_subtext != blank %}
        <div class="ai-contact-hero-subtext-{{ ai_gen_id }}">{{ block.settings.hero_subtext }}</div>
      {% endif %}
      <div class="ai-contact-hero-rule-{{ ai_gen_id }}" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 12 12" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6 0.8 7.2 4.8 11.2 6 7.2 7.2 6 11.2 4.8 7.2 0.8 6 4.8 4.8Z"/></svg>
        <span></span>
      </div>
    </div>
  </div>

  <div class="ai-contact-details-{{ ai_gen_id }}">
    <div class="ai-contact-details-container-{{ ai_gen_id }}">
      {%- liquid
        assign cu_phone = settings.whatsapp_phone
        assign cu_phone_display = settings.contact_phone_display
        if cu_phone_display == blank
          assign cu_phone_display = cu_phone
        endif
        assign cu_phone_digits = cu_phone | default: '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', ''
        assign cu_email = settings.contact_email
      -%}
      <div class="ai-contact-cards-grid-{{ ai_gen_id }}">
        {% assign cu_card_index = 0 %}
        {% if block.settings.show_phone %}
          {% if cu_phone != blank %}
            <a
              class="ai-contact-card-{{ ai_gen_id }} ai-contact-reveal-{{ ai_gen_id }}"
              data-cu-reveal
              style="--cu-stagger: {{ cu_card_index }};"
              href="tel:{{ cu_phone | replace: ' ', '' | replace: '-', '' }}"
              aria-label="Call {{ cu_phone_display | escape }}"
            >
          {% else %}
            <div class="ai-contact-card-{{ ai_gen_id }} ai-contact-reveal-{{ ai_gen_id }}" data-cu-reveal style="--cu-stagger: {{ cu_card_index }};">
          {% endif %}
