      {% render 'social-icons', class: contact_social_class, link_class: contact_social_link_class %}
    </div>
  </div>
</contact-us-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactUsSection{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        var items = this.querySelectorAll('[data-cu-reveal]');
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
        items.forEach(function (el) { observer.observe(el); });
      }
    }
    if (!customElements.get('contact-us-section-{{ ai_gen_id }}')) {
      customElements.define('contact-us-section-{{ ai_gen_id }}', ContactUsSection{{ ai_gen_id }});
    }
  })();
</script>


