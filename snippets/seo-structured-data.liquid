{%- comment -%}
  Organization + WebSite + collection breadcrumbs for Roosha.
{%- endcomment -%}

{%- liquid
  assign org_description = settings.seo_default_description
  if org_description == blank
    assign org_description = 'Shop Roosha chocolates from Himachal Pradesh — bars, dragée, truffles, hampers and curated gifts for celebrations across India.'
  endif

  assign whatsapp_digits = settings.whatsapp_phone | default: '' | replace: '+', '' | replace: ' ', '' | replace: '-', ''

  assign url_shop = '/collections/shop-chocolates' | absolute_url
  assign url_hampers = '/collections/hampers' | absolute_url
  assign url_best = '/collections/best-sellers' | absolute_url
  assign url_diwali = '/collections/diwali-collection' | absolute_url
  assign url_corporate = '/collections/corporate-gifting' | absolute_url

  if collections['shop-chocolates'] != blank
    assign url_shop = collections['shop-chocolates'].url | absolute_url
  endif
  if collections['hampers'] != blank
    assign url_hampers = collections['hampers'].url | absolute_url
  endif
  if collections['best-sellers'] != blank
    assign url_best = collections['best-sellers'].url | absolute_url
  endif
  if collections['diwali-collection'] != blank
    assign url_diwali = collections['diwali-collection'].url | absolute_url
  endif
  if collections['corporate-gifting'] != blank
    assign url_corporate = collections['corporate-gifting'].url | absolute_url
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ request.origin | append: '/#organization' | json }},
  "name": "Roosha",
  "legalName": "Roosha",
  "alternateName": {% render 'seo-brand-aliases' %},
  "url": {{ request.origin | json }},
  "description": {{ org_description | json }},
  "knowsLanguage": ["en", "hi"],
  "areaServed": {
    "@type": "Country",
    "name": "India"
  },
  {% if settings.logo %}
  "logo": {
    "@type": "ImageObject",
    "url": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
  },
  "image": {{ settings.logo | image_url: width: 1200 | prepend: 'https:' | json }},
  {% endif %}
  "sameAs": [
    {%- assign same_as_first = true -%}
    {%- if settings.social_instagram_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_instagram_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_facebook_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
    {%- if settings.social_twitter_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_twitter_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_pinterest_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_tiktok_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
    {%- if settings.social_youtube_link != blank -%}{%- unless same_as_first -%},{%- endunless -%}{{ settings.social_youtube_link | json }}{%- assign same_as_first = false -%}{%- endif -%}
  ]
  {%- if whatsapp_digits != blank -%}
  ,"contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "telephone": {{ settings.whatsapp_phone | json }},
    "availableLanguage": ["English", "Hindi"],
    "areaServed": "IN"
  }
  {%- endif -%}
}
</script>

{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ request.origin | append: '/#website' | json }},
    "name": "Roosha",
    "alternateName": {% render 'seo-brand-aliases' %},
    "url": {{ request.origin | json }},
    "description": {{ org_description | json }},
    "inLanguage": ["en-IN", "hi"],
    "publisher": {
      "@id": {{ request.origin | append: '/#organization' | json }}
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ potential_action_target | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": "Roosha",
    "alternateName": {% render 'seo-brand-aliases' %},
    "url": {{ request.origin | json }},
    "description": {{ org_description | json }},
    "image": {% if settings.logo %}{{ settings.logo | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}{{ request.origin | json }}{% endif %},
    "priceRange": "₹₹",
    "currenciesAccepted": "INR",
    "paymentAccepted": "UPI, Credit Card, Debit Card, Net Banking",
    "areaServed": {
      "@type": "Country",
      "name": "India"
    }
    {%- if whatsapp_digits != blank -%}
    ,"telephone": {{ settings.whatsapp_phone | json }}
    {%- endif -%}
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Roosha popular destinations",
    "itemListElement": [
      {
        "@type": "SiteNavigationElement",
        "position": 1,
        "name": "Shop Chocolates",
        "description": "Shop all Roosha chocolates — bars, dragée, truffles, bonbons and more.",
        "url": {{ url_shop | json }}
      },
      {
        "@type": "SiteNavigationElement",
        "position": 2,
        "name": "Hampers",
        "description": "Curated Roosha chocolate hampers for birthdays, festivals and gifting.",
        "url": {{ url_hampers | json }}
      },
      {
        "@type": "SiteNavigationElement",
        "position": 3,
        "name": "Best Sellers",
        "description": "Roosha bestsellers — the chocolates people gift and reorder.",
        "url": {{ url_best | json }}
      },
      {
        "@type": "SiteNavigationElement",
        "position": 4,
        "name": "Diwali Collection",
        "description": "Festive Roosha chocolate boxes and hampers for Diwali.",
        "url": {{ url_diwali | json }}
      },
      {
        "@type": "SiteNavigationElement",
        "position": 5,
        "name": "Corporate Gifting",
        "description": "Roosha corporate chocolate gifts, onboarding boxes and return favours.",
        "url": {{ url_corporate | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' -%}
  {%- assign collection_seo_description = collection.description | strip_html | strip | truncate: 160 -%}
  {%- if collection_seo_description == blank -%}
    {%- assign collection_seo_description = org_description -%}
  {%- endif -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection_seo_description | json }},
    "url": {{ canonical_url | json }},
    "isPartOf": {
      "@id": {{ request.origin | append: '/#website' | json }}
    },
    "about": {
      "@type": "Thing",
      "name": {{ collection.title | append: ' chocolate | Roosha' | json }}
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
