{%- style -%}
  .roosha-story-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  .roosha-story-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: center;
  }
  .roosha-story-{{ section.id }}__media {
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #c4a35a;
    aspect-ratio: 4 / 3;
    background: #f3ebe0;
  }
  .roosha-story-{{ section.id }}__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .roosha-story-{{ section.id }}__eyebrow {
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 1.2rem;
    color: #c4a35a;
    margin-bottom: 1.2rem;
  }
  .roosha-story-{{ section.id }}__title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    color: #6b1e2a;
    margin: 0 0 1.6rem;
    font-weight: 500;
  }
  .roosha-story-{{ section.id }}__quote {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2rem, 3vw, 2.6rem);
    line-height: 1.45;
    color: #6b1e2a;
    margin: 0 0 1.8rem;
    font-weight: 500;
  }
  .roosha-story-{{ section.id }}__text {
    color: #5a4548;
    font-size: 1.55rem;
    line-height: 1.7;
    margin: 0 0 2.2rem;
  }
  @media screen and (min-width: 900px) {
    .roosha-story-{{ section.id }}__grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 5.6rem;
    }
  }
{%- endstyle -%}

<section class="roosha-story-{{ section.id }}" id="our-story">
  <div class="page-width">
    <div class="roosha-story-{{ section.id }}__grid">
      <div class="roosha-story-{{ section.id }}__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 900px) 45vw, 100vw'
          }}
        {% else %}
          <img src="{{ 'roosha-story.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1400" height="1050">
        {% endif %}
      </div>
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="roosha-story-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="roosha-story-{{ section.id }}__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.quote != blank %}
          <p class="roosha-story-{{ section.id }}__quote">{{ section.settings.quote }}</p>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="roosha-story-{{ section.id }}__text">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roosha story",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chocolate made for celebration." },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "At Roosha, we believe chocolate is more than a treat. It is a way to celebrate, connect, and create memories. From indulgent chocolate bars to carefully curated gifts, every creation is designed to make ordinary moments feel extraordinary."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Based in Himachal Pradesh, Roosha is a premium chocolate and curated gifting brand for everyday craving, festive celebration, weddings, and thoughtful corporate gestures."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact Roosha" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffcf8" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [{ "name": "Roosha story" }]
}
{% endschema %}
