  {% if block.settings.show_form %}
    <div class="ai-contact-form-wrap-{{ ai_gen_id }}">
      <div class="ai-contact-form-inner-{{ ai_gen_id }} ai-contact-reveal-{{ ai_gen_id }}" data-cu-reveal>
        <div class="ai-contact-form-intro-{{ ai_gen_id }}">
          <p class="ai-contact-form-eyebrow-{{ ai_gen_id }}">Say hello</p>
          {% if block.settings.form_title != blank %}
            <h2 class="ai-contact-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
          {% endif %}
          {% if block.settings.form_subtitle != blank %}
            <p class="ai-contact-form-subtitle-{{ ai_gen_id }}">{{ block.settings.form_subtitle }}</p>
          {% endif %}
        </div>

        <div class="ai-contact-form-panel-{{ ai_gen_id }}">
          {%- assign contact_form_id = 'ContactForm-' | append: ai_gen_id -%}
          {%- form 'contact', id: contact_form_id -%}
            {%- if form.posted_successfully? -%}
              <div class="ai-contact-form-success-{{ ai_gen_id }}" tabindex="-1">
                {{ block.settings.form_success_message }}
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="ai-contact-form-error-{{ ai_gen_id }}" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="ai-contact-form-grid-{{ ai_gen_id }}">
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label for="ContactForm-name-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">Name</label>
                <input
                  type="text"
                  id="ContactForm-name-{{ ai_gen_id }}"
                  name="contact[name]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  autocomplete="name"
                  placeholder="Your full name"
                  required
                  aria-required="true"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                >
              </div>

              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label for="ContactForm-email-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">Email</label>
                <input
                  type="email"
                  id="ContactForm-email-{{ ai_gen_id }}"
                  name="contact[email]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  placeholder="you@email.com"
                  required
                  aria-required="true"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                >
              </div>

              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label for="ContactForm-phone-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">Phone <span style="opacity:0.55;font-weight:400;">(optional)</span></label>
                <input
                  type="tel"
                  id="ContactForm-phone-{{ ai_gen_id }}"
                  name="contact[phone]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  autocomplete="tel"
                  placeholder="+91"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
              </div>

              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label for="ContactForm-order-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">Order ID <span style="opacity:0.55;font-weight:400;">(optional)</span></label>
                <input
                  type="text"
                  id="ContactForm-order-{{ ai_gen_id }}"
                  name="contact[order_id]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  placeholder="e.g. #1234"
                >
              </div>

              <div class="ai-contact-form-field-{{ ai_gen_id }} ai-contact-form-field-{{ ai_gen_id }}--full">
                <label for="ContactForm-body-{{ ai_gen_id }}" class="ai-contact-form-label-{{ ai_gen_id }}">Message</label>
                <textarea
                  id="ContactForm-body-{{ ai_gen_id }}"
