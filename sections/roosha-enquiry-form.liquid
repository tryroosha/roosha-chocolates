{%- style -%}
  .roosha-enq-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    overflow-x: clip;
  }
  .roosha-enq-{{ section.id }} .page-width {
    max-width: 110rem;
  }
  .roosha-enq-{{ section.id }}__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.8rem;
    align-items: start;
    width: 100%;
    max-width: 100%;
  }
  .roosha-enq-{{ section.id }}__copy,
  .roosha-enq-{{ section.id }}__form {
    min-width: 0;
    max-width: 100%;
  }
  .roosha-enq-{{ section.id }}__eyebrow {
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 1.15rem;
    color: #c4a35a;
    margin: 0 0 1.2rem;
  }
  .roosha-enq-{{ section.id }}__title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.6rem, 4vw, 3.8rem);
    color: #6b1e2a;
    margin: 0 0 1.2rem;
    font-weight: 500;
    line-height: 1.15;
  }
  .roosha-enq-{{ section.id }}__text {
    color: #5a4548;
    font-size: 1.5rem;
    line-height: 1.7;
    margin: 0 0 1.8rem;
  }
  .roosha-enq-{{ section.id }}__meta {
    display: grid;
    gap: 1rem;
    margin: 0 0 2rem;
  }
  .roosha-enq-{{ section.id }}__meta a,
  .roosha-enq-{{ section.id }}__meta span {
    display: block;
    color: #6b1e2a;
    text-decoration: none;
    font-size: 1.4rem;
    line-height: 1.5;
  }
  .roosha-enq-{{ section.id }}__meta strong {
    display: block;
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a7a3a;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }
  .roosha-enq-{{ section.id }}__media {
    margin-top: 0.4rem;
    border: 1px solid rgba(196, 163, 90, 0.55);
    overflow: hidden;
    max-width: 100%;
  }
  .roosha-enq-{{ section.id }}__media img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .roosha-enq-{{ section.id }}__form {
    background: #fffcf8;
    border: 1px solid #e6d9cc;
    padding: 2rem 1.6rem;
    width: 100%;
    box-sizing: border-box;
  }
  .roosha-enq-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
  }
  .roosha-enq-{{ section.id }}__field {
    min-width: 0;
  }
  .roosha-enq-{{ section.id }} label {
    display: block;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b1e2a;
    margin-bottom: 0.55rem;
  }
  .roosha-enq-{{ section.id }} input,
  .roosha-enq-{{ section.id }} select,
  .roosha-enq-{{ section.id }} textarea {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border: 1px solid #dccfc2;
    border-radius: 2px;
    background: #faf7f2;
    padding: 1.15rem 1.25rem;
    font: inherit;
    color: #2a1a1c;
    appearance: none;
  }
  .roosha-enq-{{ section.id }} select {
    background-image: linear-gradient(45deg, transparent 50%, #6b1e2a 50%),
      linear-gradient(135deg, #6b1e2a 50%, transparent 50%);
    background-position: calc(100% - 18px) calc(50% - 3px), calc(100% - 12px) calc(50% - 3px);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 3.2rem;
  }
  .roosha-enq-{{ section.id }} textarea {
    min-height: 11rem;
    resize: vertical;
  }
  .roosha-enq-{{ section.id }}__full {
    grid-column: 1 / -1;
  }
  .roosha-enq-{{ section.id }}__actions {
    margin-top: 0.4rem;
  }
  .roosha-enq-{{ section.id }}__actions .button {
    width: 100%;
    min-height: 5rem;
  }
  .roosha-enq-{{ section.id }}__success {
    color: #6b1e2a;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 2rem;
    margin: 0;
    line-height: 1.35;
  }
  @media screen and (min-width: 750px) {
    .roosha-enq-{{ section.id }}__form {
      padding: 2.8rem;
    }
    .roosha-enq-{{ section.id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1.8rem;
    }
    .roosha-enq-{{ section.id }}__actions .button {
      width: auto;
      min-width: 22rem;
    }
  }
  @media screen and (min-width: 990px) {
    .roosha-enq-{{ section.id }}__wrap {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4.8rem;
    }
    .roosha-enq-{{ section.id }}--stacked .roosha-enq-{{ section.id }}__wrap {
      grid-template-columns: minmax(0, 1fr);
      max-width: 76rem;
      margin: 0 auto;
    }
    .roosha-enq-{{ section.id }}--stacked .roosha-enq-{{ section.id }}__copy {
      text-align: center;
    }
    .roosha-enq-{{ section.id }}--stacked .roosha-enq-{{ section.id }}__meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.6rem;
      text-align: left;
    }
    .roosha-enq-{{ section.id }}--stacked .roosha-enq-{{ section.id }}__media {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign layout_class = ''
  if section.settings.layout == 'stacked'
    assign layout_class = ' roosha-enq-' | append: section.id | append: '--stacked'
  endif
-%}

<section class="roosha-enq-{{ section.id }}{{ layout_class }}" id="enquiry">
  <div class="page-width">
    <div class="roosha-enq-{{ section.id }}__wrap">
      <div class="roosha-enq-{{ section.id }}__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="roosha-enq-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="roosha-enq-{{ section.id }}__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="roosha-enq-{{ section.id }}__text">{{ section.settings.text }}</div>
        {% endif %}

        <div class="roosha-enq-{{ section.id }}__meta">
          <div>
            <strong>Email</strong>
            <a href="mailto:hello@tryroosha.com">hello@tryroosha.com</a>
          </div>
          <div>
            <strong>WhatsApp</strong>
            <a href="https://wa.me/917777877253" target="_blank" rel="noopener">+91 77778 77253</a>
          </div>
          <div>
            <strong>Based in</strong>
            <span>Himachal Pradesh, India</span>
          </div>
        </div>

        {% if section.settings.layout != 'stacked' %}
          {% if section.settings.image != blank %}
            <div class="roosha-enq-{{ section.id }}__media">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 990px) 36vw, 100vw'
              }}
            </div>
          {% elsif section.settings.fallback_asset != blank %}
            <div class="roosha-enq-{{ section.id }}__media">
              <img
                src="{{ section.settings.fallback_asset | asset_url }}"
                alt="{{ section.settings.heading | escape }}"
                loading="lazy"
                width="900"
                height="675"
              >
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="roosha-enq-{{ section.id }}__form">
        {%- form 'contact', id: 'RooshaEnquiryForm' -%}
          {% if form.posted_successfully? %}
            <p class="roosha-enq-{{ section.id }}__success" tabindex="-1" autofocus>
              Thank you. Your enquiry has been received. Our team will respond shortly.
            </p>
          {% else %}
            <input type="hidden" name="contact[form_type]" value="{{ section.settings.form_type }}">
            <div class="roosha-enq-{{ section.id }}__grid">
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-name">Name</label>
                <input id="RooshaEnquiry-name" type="text" name="contact[name]" required autocomplete="name">
              </div>
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-email">Email</label>
                <input id="RooshaEnquiry-email" type="email" name="contact[email]" required autocomplete="email" spellcheck="false">
              </div>
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-phone">Phone</label>
                <input id="RooshaEnquiry-phone" type="tel" name="contact[phone]" required autocomplete="tel">
              </div>
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-occasion">Occasion</label>
                <select id="RooshaEnquiry-occasion" name="contact[occasion]">
                  <option value="General">General enquiry</option>
                  <option value="Diwali">Diwali</option>
                  <option value="Wedding">Wedding</option>
                  <option value="Anniversary">Anniversary</option>
                  <option value="Birthday">Birthday</option>
                  <option value="Corporate">Corporate celebration</option>
                  <option value="Return gifts">Festive return gifts</option>
                  <option value="Custom bar">Custom chocolate bar</option>
                  <option value="Other">Other special occasion</option>
                </select>
              </div>
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-qty">Approximate quantity</label>
                <input id="RooshaEnquiry-qty" type="text" name="contact[quantity]" placeholder="e.g. 50 boxes">
              </div>
              <div class="roosha-enq-{{ section.id }}__field">
                <label for="RooshaEnquiry-date">Required delivery date</label>
                <input id="RooshaEnquiry-date" type="date" name="contact[delivery_date]">
              </div>
              <div class="roosha-enq-{{ section.id }}__field roosha-enq-{{ section.id }}__full">
                <label for="RooshaEnquiry-products">Preferred chocolate products</label>
                <input id="RooshaEnquiry-products" type="text" name="contact[preferred_products]" placeholder="Mini bars, filled bars, favour boxes…">
              </div>
              <div class="roosha-enq-{{ section.id }}__field roosha-enq-{{ section.id }}__full">
                <label for="RooshaEnquiry-personalization">Personalization requirements</label>
                <textarea id="RooshaEnquiry-personalization" name="contact[personalization]" placeholder="Names, messages, branding, packaging…"></textarea>
              </div>
              <div class="roosha-enq-{{ section.id }}__field roosha-enq-{{ section.id }}__full">
                <label for="RooshaEnquiry-notes">Additional instructions</label>
                <textarea id="RooshaEnquiry-notes" name="contact[body]" placeholder="Tell us anything else we should know."></textarea>
              </div>
              <div class="roosha-enq-{{ section.id }}__full roosha-enq-{{ section.id }}__actions">
                <button type="submit" class="button">{{ section.settings.button_label }}</button>
              </div>
            </div>
          {% endif %}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roosha enquiry form",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wedding & corporate gifting" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a quote for your celebration." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Share your occasion, quantity, and personalisation needs. Our team will confirm feasibility, packaging, and pricing."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Split with image" },
        { "value": "stacked", "label": "Stacked contact form" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "form_type", "label": "Form type tag", "default": "Wedding & Corporate Quote" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a Quote" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset", "default": "roosha-wedding-gifting.jpg" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf7f2" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [{ "name": "Roosha enquiry form" }]
}
{% endschema %}
