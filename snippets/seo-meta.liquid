{%- comment -%}
  Builds SEO title + description for Roosha chocolates.
  Sets seo_og_title / seo_og_description for meta-tags.
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title | strip
  assign seo_description = page_description | strip
  assign default_home_title = 'Roosha | Premium Chocolates & Curated Gifting'
  assign default_description = 'Shop Roosha chocolates from Himachal Pradesh — bars, dragée, truffles, hampers and curated gifts. Packed with care for celebrations across India.'

  if settings.seo_homepage_title != blank
    assign default_home_title = settings.seo_homepage_title
  endif
  if settings.seo_default_description != blank
    assign default_description = settings.seo_default_description
  endif
  if settings.seo_homepage_description != blank
    assign homepage_description = settings.seo_homepage_description
  else
    assign homepage_description = default_description
  endif

  assign description_is_weak = false
  if seo_description == blank or seo_description == 'Welcome to our store' or seo_description == 'Welcome to our store.'
    assign description_is_weak = true
  endif

  if request.page_type == 'index'
    if settings.seo_homepage_title != blank
      assign seo_title = settings.seo_homepage_title
    elsif seo_title == blank or seo_title == shop.name
      assign seo_title = default_home_title
    endif

    if settings.seo_homepage_description != blank
      assign seo_description = homepage_description
      assign description_is_weak = false
    elsif description_is_weak
      assign seo_description = homepage_description
      assign description_is_weak = false
    endif
  endif

  if request.page_type == 'collection'
    if collection.title != blank and seo_title == blank
      assign seo_title = collection.title | append: ' | Roosha'
    elsif collection.title != blank and seo_title == collection.title
      assign seo_title = collection.title | append: ' | Roosha'
    endif
    if description_is_weak
      if collection.description != blank
        assign seo_description = collection.description | strip_html | strip | truncate: 155
      else
        assign seo_description = 'Shop ' | append: collection.title | append: ' at Roosha — premium chocolates and curated gifts packed in Himachal Pradesh.'
      endif
      assign description_is_weak = false
    endif
  endif

  if request.page_type == 'product'
    assign product_title_stripped = product.title | strip
    if page_title != blank and page_title != product.title
      assign seo_title = page_title | strip
    else
      assign title_tail = product_title_stripped | slice: -6, 6 | downcase
      if title_tail == 'roosha'
        assign seo_title = product_title_stripped
      else
        assign seo_title = product_title_stripped | append: ' | Roosha'
      endif
    endif

    assign product_desc_plain = product.description | strip_html | strip_newlines | strip
    if product_desc_plain != blank
      assign seo_description = product_desc_plain | truncate: 150, ''
    else
      assign seo_description = 'Shop ' | append: product.title | append: ' at Roosha. Premium chocolate packed in Himachal Pradesh, ready for gifting across India.'
    endif
    assign description_is_weak = false
  endif

  if description_is_weak
    if request.page_type == 'list-collections'
      assign seo_title = 'Collections | Roosha Chocolates'
      assign seo_description = 'Browse Roosha chocolate collections — dragée, bars, truffles, bonbons, hampers and festive gifts.'
    elsif request.page_type == 'page'
      case page.handle
        when 'our-story', 'about-us'
          assign seo_description = 'The Roosha story — premium chocolate and curated gifting from Himachal Pradesh.'
        when 'contact'
          assign seo_description = 'Contact Roosha for orders, custom gifts, wedding favours and corporate enquiries. Email hello@tryroosha.com or WhatsApp +91 77778 77253.'
        when 'faqs', 'faq'
          assign seo_description = 'Roosha FAQ — shipping, storage, returns and ordering for premium chocolates and gift hampers.'
        when 'occasions'
          assign seo_description = 'Shop Roosha chocolates by occasion — birthdays, weddings, anniversaries, house warming and Diwali.'
        when 'corporate-gifting'
          assign seo_description = 'Roosha corporate gifting — branded chocolate gifts, onboarding boxes and return favours.'
        when 'build-your-own-hamper'
          assign seo_description = 'Build your own Roosha chocolate hamper. Tell us the occasion, quantity and packaging.'
        when 'bulk-order'
          assign seo_description = 'Roosha bulk chocolate orders for weddings, festivals and corporate celebrations.'
        when 'chocolate-tasting'
          assign seo_description = 'Book a Roosha chocolate tasting — three tastes, guided and made for celebration.'
        else
          if page.content != blank
            assign seo_description = page.content | strip_html | strip | truncate: 155
          else
            assign seo_description = default_description
          endif
      endcase
    elsif request.page_type == 'article' and article.excerpt_or_content != blank
      assign seo_description = article.excerpt_or_content | strip_html | strip | truncate: 155
    elsif shop.description != blank and shop.description != 'Welcome to our store' and shop.description != 'Welcome to our store.'
      assign seo_description = shop.description | strip_html | strip | truncate: 155
    else
      assign seo_description = default_description
    endif
  endif

  assign seo_og_title = seo_title
  assign seo_og_description = seo_description
-%}
