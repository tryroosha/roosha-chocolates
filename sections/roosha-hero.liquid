{{ 'roosha-brand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image_url = ''
  if section.settings.image != blank
    assign hero_image_url = section.settings.image | image_url: width: 2400
  else
    assign hero_image_url = 'roosha-hero-gift.jpg' | asset_url
  endif
-%}

{%- style -%}
  .roosha-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: {{ section.settings.mobile_height }}px;
    color: {{ section.settings.text_color }};
    background:
      linear-gradient(105deg, rgba(42, 14, 20, 0.78) 0%, rgba(74, 18, 28, 0.48) 48%, rgba(42, 14, 20, 0.28) 100%),
      url({{ hero_image_url | json }}) center / cover no-repeat;
  }
  .roosha-hero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    background: linear-gradient(180deg, transparent, rgba(42, 14, 20, 0.35));
    pointer-events: none;
  }
  .roosha-hero-{{ section.id }}__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    min-height: inherit;
    padding: 6.4rem 0 4.8rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .roosha-hero-{{ section.id }}__content {
    width: 100%;
    max-width: 62rem;
    min-width: 0;
    animation: rooshaHeroRise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .roosha-hero-{{ section.id }}__brand {
    font-family: "Cormorant Garamond", Georgia, serif;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: clamp(2rem, 4vw, 3.4rem);
    color: #faf7f2 !important;
    margin: 0 0 1.2rem;
    font-weight: 500;
    padding-right: 0.22em; /* offset trailing letter-spacing */
    max-width: 100%;
  }
  .roosha-hero-{{ section.id }}__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 1.1rem;
    color: {{ section.settings.accent_color }};
    margin: 0 0 1.4rem;
    font-weight: 500;
    max-width: 100%;
  }
  .roosha-hero-{{ section.id }}__eyebrow::before,
  .roosha-hero-{{ section.id }}__eyebrow::after {
    content: "";
    width: 1.6rem;
    height: 1px;
    flex: 0 0 auto;
    background: {{ section.settings.accent_color }};
  }
  .roosha-hero-{{ section.id }}__title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 4.6vw, 5rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    color: {{ section.settings.heading_color }} !important;
    margin: 0 0 1.4rem;
    max-width: 100%;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
  .roosha-hero-{{ section.id }}__text {
    font-size: clamp(1.35rem, 2.2vw, 1.55rem);
    line-height: 1.65;
    color: {{ section.settings.text_color }};
    max-width: 42rem;
    margin: 0 0 2.4rem;
  }
  .roosha-hero-{{ section.id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .roosha-hero-{{ section.id }}__actions .button {
    max-width: 100%;
  }
  @media screen and (min-width: 750px) {
    .roosha-hero-{{ section.id }}__brand {
      letter-spacing: 0.32em;
      padding-right: 0.32em;
      font-size: clamp(2.4rem, 3.2vw, 3.6rem);
    }
    .roosha-hero-{{ section.id }}__eyebrow {
      letter-spacing: 0.18em;
    }
    .roosha-hero-{{ section.id }}__title {
      max-width: 28ch;
    }
  }
  @media screen and (min-width: 1100px) {
    .roosha-hero-{{ section.id }}__title {
      max-width: 16ch;
      font-size: clamp(3.6rem, 4.2vw, 5.2rem);
    }
  }
  .roosha-hero-{{ section.id }} .button--secondary {
    background: transparent !important;
    color: #faf7f2 !important;
    border-color: rgba(196, 163, 90, 0.85) !important;
  }
  .roosha-hero-{{ section.id }} .button--secondary:hover {
    background: #6b1e2a !important;
    border-color: #6b1e2a !important;
  }
  @keyframes rooshaHeroRise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media screen and (min-width: 900px) {
    .roosha-hero-{{ section.id }} {
      min-height: {{ section.settings.desktop_height }}px;
    }
    .roosha-hero-{{ section.id }}__inner {
      padding: 10rem 0 7.2rem;
    }
  }
{%- endstyle -%}

<section class="roosha-hero-{{ section.id }}">
  <div class="page-width roosha-hero-{{ section.id }}__inner">
    <div class="roosha-hero-{{ section.id }}__content">
      <p class="roosha-hero-{{ section.id }}__brand">{{ section.settings.brand_name }}</p>
      {% if section.settings.eyebrow != blank %}
        <p class="roosha-hero-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="roosha-hero-{{ section.id }}__title">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <div class="roosha-hero-{{ section.id }}__text">{{ section.settings.text }}</div>
      {% endif %}
      <div class="roosha-hero-{{ section.id }}__actions">
        {% if section.settings.button_label != blank %}
          <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roosha hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "ROOSHA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium chocolates · Himachal Pradesh" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Every Craving. Curated for Every Celebration."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "From glossy everyday bars to filled indulgences and thoughtfully wrapped gifts, Roosha brings boutique chocolate craft to moments worth sharing."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore Chocolates" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Discover Gifting" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "desktop_height", "min": 480, "max": 900, "step": 10, "unit": "px", "label": "Desktop min height", "default": 720 },
    { "type": "range", "id": "mobile_height", "min": 420, "max": 900, "step": 10, "unit": "px", "label": "Mobile min height", "default": 620 },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#2a0e14" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#faf7f2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3ebe0" },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#c4a35a" }
  ],
  "presets": [{ "name": "Roosha hero" }]
}
{% endschema %}
