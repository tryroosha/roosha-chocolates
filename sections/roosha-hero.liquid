{{ 'roosha-brand.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .roosha-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    min-height: {{ section.settings.mobile_height }}px;
  }
  .roosha-hero-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: center;
    padding: 4.8rem 0 5.6rem;
  }
  .roosha-hero-{{ section.id }}__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 1.2rem;
    color: {{ section.settings.accent_color }};
    margin-bottom: 1.6rem;
    font-weight: 500;
  }
  .roosha-hero-{{ section.id }}__eyebrow::before,
  .roosha-hero-{{ section.id }}__eyebrow::after {
    content: "";
    width: 2.4rem;
    height: 1px;
    background: {{ section.settings.accent_color }};
  }
  .roosha-hero-{{ section.id }}__title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: clamp(3.2rem, 6vw, 5.6rem);
    line-height: 1.08;
    letter-spacing: 0.01em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 1.6rem;
    max-width: 14ch;
  }
  .roosha-hero-{{ section.id }}__text {
    font-size: 1.6rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 42rem;
    margin: 0 0 2.8rem;
  }
  .roosha-hero-{{ section.id }}__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .roosha-hero-{{ section.id }}__media {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid {{ section.settings.accent_color }};
    box-shadow: 0 24px 60px rgba(74, 18, 28, 0.12);
    aspect-ratio: 4 / 3;
    background: #f3ebe0;
  }
  .roosha-hero-{{ section.id }}__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .roosha-hero-{{ section.id }}__brand {
    font-family: "Cormorant Garamond", Georgia, serif;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    font-size: 1.4rem;
    color: {{ section.settings.heading_color }};
    margin-bottom: 1.2rem;
  }
  @media screen and (min-width: 900px) {
    .roosha-hero-{{ section.id }} {
      min-height: {{ section.settings.desktop_height }}px;
    }
    .roosha-hero-{{ section.id }}__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4.8rem;
      padding: 7.2rem 0;
    }
  }
{%- endstyle -%}

<section class="roosha-hero-{{ section.id }}">
  <div class="page-width">
    <div class="roosha-hero-{{ section.id }}__grid">
      <div>
        <p class="roosha-hero-{{ section.id }}__brand">{{ section.settings.brand_name }}</p>
        {% if section.settings.eyebrow != blank %}
          <p class="roosha-hero-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1 class="roosha-hero-{{ section.id }}__title">{{ section.settings.heading }}</h1>
        {% if section.settings.text != blank %}
          <div class="roosha-hero-{{ section.id }}__text">{{ section.settings.text }}</div>
        {% endif %}
        <div class="roosha-hero-{{ section.id }}__actions">
          {% if section.settings.button_label != blank %}
            <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>
      <div class="roosha-hero-{{ section.id }}__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 900px) 48vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {% else %}
          {{ 'roosha-hero-gift.jpg' | asset_url | img_tag: section.settings.heading }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roosha hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "ROOSHA" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium chocolates · Himachal Pradesh" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Every Craving. Curated for Every Celebration."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "From glossy everyday bars to filled indulgences and thoughtfully wrapped gifts, Roosha brings boutique chocolate craft to moments worth sharing."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore Chocolates" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Discover Gifting" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "desktop_height", "min": 480, "max": 900, "step": 10, "unit": "px", "label": "Desktop min height", "default": 680 },
    { "type": "range", "id": "mobile_height", "min": 420, "max": 900, "step": 10, "unit": "px", "label": "Mobile min height", "default": 560 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#faf7f2" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#6b1e2a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5a4548" },
    { "type": "color", "id": "accent_color", "label": "Gold accent", "default": "#c4a35a" }
  ],
  "presets": [{ "name": "Roosha hero" }]
}
{% endschema %}
